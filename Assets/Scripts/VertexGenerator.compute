[numthreads(16,1,16)]
void ComputeMesh (uint3 id : SV_DispatchThreadID)
{


    //uint3 pos = uint3(id.x % Size.x, y, id.z % Size.z);
    uint3 pos = uint3(id.x % Size.x, id.y % Size.y, id.z % Size.z);
    uint voxIndex = ComputeIndex(pos, Size);
    uint voxelID = Voxels[voxIndex].ID;  


    if (voxelID > 0) { // only run if voxel is not empty
            
        uint voxelDamage = Voxels[voxIndex].Damage;
        //uint voxelOrientation = Voxels[voxIndex].Orientation;
           
        // Check value of 6 adjacent voxels, and if current voxel is on chunk edge
        uint faceBorders[6] = { 0, 0, 0, 0, 0, 0 };

        if (pos.x > 0) {
            faceBorders[0] = Voxels[ComputeIndex(pos + NormNX, Size)].ID;
        }
        if (pos.x < Size.x - 1){
            faceBorders[1] = Voxels[ComputeIndex(pos + NormPX, Size)].ID;
        }
        if (pos.y > 0) {
            faceBorders[2] = Voxels[ComputeIndex(pos + NormNY, Size)].ID;
        }
        if (pos.y < Size.y - 1){
            faceBorders[3] = Voxels[ComputeIndex(pos + NormPY, Size)].ID;
        }
        if (pos.z > 0) {
            faceBorders[4] = Voxels[ComputeIndex(pos + NormNZ, Size)].ID;
        }
        if (pos.z < Size.z - 1){
            faceBorders[5] = Voxels[ComputeIndex(pos + NormPZ, Size)].ID;
        }


        // If adjacent voxel is empty, add a face
            
        uint index = 0; // map from index in Voxel buffer to index in vertex buffer, which has 24 spaces per Voxel (6 faces * 4 verts)
        uint index2 = 0;
        
        
        float4 faceColor = float4(voxelID, 0., voxelDamage, 1.);
            
        // float3 posOffset = float3(0.499,0.499,0.499);
        float3 posOffset = float3(0.0,0.0,0.0);
                    
        for (int f = 0; f < 6; f++)
        {
            if (faceBorders[f] == 0)
            {
                int newIndices[4] = { 0, 1, 2, 3 };
                for (int i = 0; i < 4; i++)
                {
                    index = Vertices.IncrementCounter();
                    //newIndices[i] = index;
                    Vertices[index] = FaceVerts[f][i] + pos;
                    Normals[index] = FaceNorms[f];
                    Colors[index] = float4(faceColor.x, 0., faceColor.z, faceColor.w);
                    TexCoords[index] = FaceTex[f][3 - i];
                    ValidIndices[index] = 1;
                }
                
                Indices[Indices.IncrementCounter()] = newIndices[0];
                Indices[Indices.IncrementCounter()] = newIndices[1];
                Indices[Indices.IncrementCounter()] = newIndices[2];
                Indices[Indices.IncrementCounter()] = newIndices[0];
                Indices[Indices.IncrementCounter()] = newIndices[2];
                Indices[Indices.IncrementCounter()] = newIndices[3];
            }
