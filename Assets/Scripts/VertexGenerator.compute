struct VoxelData 
{
    uint ID;
    uint Damage;
    uint Orientation;
};

// Map from a 3D voxel pos to an index in the flat voxel buffer
int ComputeIndex(uint3 pos, uint3 size) { 
    return pos.x + size.x * pos.y + size.x * size.y * pos.z;
}

VoxelData NewVoxelData(uint id, uint damage, uint orientation) {
    VoxelData result;
    result.ID = id;
    result.Damage = damage;
    result.Orientation = orientation;
    return result;
}




RWStructuredBuffer<int> VoxelIDs;
RWStructuredBuffer<VoxelData> Voxels;

uint3 Size;
float Scale;
float Threshold;
float3 TranslateNoise;

[numthreads(16,1,16)]
void GenerateTerrain (uint3 id : SV_DispatchThreadID)
{
    uint3 pos = uint3(id.x % Size.x, id.y % Size.y, id.z % Size.z);
    int index = ComputeIndex(pos, Size);

    float n = SimplexNoise((float3(pos.x,0.,pos.z) + TranslateNoise) * Scale);
    float yRamp = pow(1-(float(pos.y) / Size.y), 2.);

    float t = yRamp;
    t += n * 0.1;

        

    if (t > 0.5) {
        VoxelIDs[index] = 3; 
    } else {
        VoxelIDs[index] = 0; 
    }

    //if (voxelID == 1 && y < Size.y-1) { // put dirt under grass
    //    if(Voxels[ComputeIndex(pos + uint3(0,1,0), Size)] > 0) {
    //        voxelID = 2;
    //    } 
    //}
    //Voxels[index] = 1;
    
}   



[numthreads(16,1,16)]
void SetTerrainBlocks (uint3 id : SV_DispatchThreadID) {
    uint3 pos = uint3(id.x % Size.x, id.y % Size.y, id.z % Size.z);

    int index = ComputeIndex(pos, Size);

    int voxel = VoxelIDs[index];
    int voxel_up1 = VoxelIDs[ComputeIndex(pos + uint3(0,1,0), Size)];

    int index_down1 = ComputeIndex(pos + uint3(0,-1,0), Size);
    int index_down2 = ComputeIndex(pos + uint3(0,-2,0), Size);

    if (voxel > 0) {
            
        if (pos.y == Size.y-1 || voxel_up1 == 0) {
            VoxelIDs[index] = 1;

            for (uint i=1; i<4; i++) {
                if (pos.y > i-1) {
                    VoxelIDs[ComputeIndex(pos + uint3(0,-1 * i,0), Size)] = 2;
                }
            }
                
        } else {
            float n = SimplexNoise((pos + TranslateNoise) * Scale * 3.);
            if (n < -0.3) {
                VoxelIDs[index] = 4;
            }
        }
    }

    
}

[numthreads(16,1,16)]
void AddOres (uint3 id : SV_DispatchThreadID) {

    uint3 pos = uint3(id.x % Size.x, id.y % Size.y, id.z % Size.z);
    int index = ComputeIndex(pos, Size);

    if (VoxelIDs[index] == 3) {
        float n = SimplexNoise(pos * 100.);
        if (n < 0.00001) {
            VoxelIDs[index] = 6;
        }
    }
        
}


RWStructuredBuffer<float3> Vertices;
RWStructuredBuffer<float3> Normals;
RWStructuredBuffer<float4> Colors;
RWStructuredBuffer<float2> TexCoords;
RWStructuredBuffer<int> ValidIndices;
