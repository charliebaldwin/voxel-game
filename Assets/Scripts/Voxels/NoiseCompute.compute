

#include "Packages/jp.keijiro.noiseshader/Shader/SimplexNoise3D.hlsl"
#include "Packages/jp.keijiro.noiseshader/Shader/ClassicNoise3D.hlsl"
#include "Assets/Art/Shaders/Hash.hlsl"
#include "Assets/Art/Shaders/ErosionTerrain.hlsl"
#include "Assets/Art/Shaders/GaussianBlur.hlsl"

// KERNELS
#pragma kernel InitialHeight
#pragma kernel PostProcess
#pragma kernel AddTrees
#pragma kernel GenerateNoiseCaves
#pragma kernel SetStone
#pragma kernel ErodeSurface
#pragma kernel AddSoilLayer
#pragma kernel AddWater
#pragma kernel RandomInt

// BUFFERS
RWStructuredBuffer<float> NoiseBuffer;
RWStructuredBuffer<int> VoxelBufferW;
RWStructuredBuffer<int> VoxelBufferR;
RWStructuredBuffer<float3> SoilBuffer;
RWStructuredBuffer<int> RandomBuffer;

// SETTINGS
int3 WorldSize;
int3 WorldOrigin;

int3 ThreadCount;
int3 ThreadSize;
int3 ThreadGroups;
int Seed;

float3 Scale;
int Octaves; 
float OctaveStrength;
float OctaveScale;

float CaveWidth;

float remap(float value, float originMin, float originMax, float destinationMin, float destinationMax) {
    return destinationMin + (value - originMin) * (destinationMax - destinationMin) / (originMax - originMin);
}
float smoothstep(float x) {
    float t = clamp(x / 1, 0, 1);
    return t * t * (3-2*t);
}
float noise(float3 p, int seed, float3 scale, int octaves, float octaveStrength, float octaveScale) {
    float result = 0;
    float str = 1;
    float3 scaleO = scale;

    float3 seedP = hash31(seed+1); 

    for (int o = 0; o < octaves; o++)
    {    
        result += str * SimplexNoise(p * scaleO + seedP);
        str *= octaveStrength;
        scaleO *= octaveScale;
    }
    return 0.5 + 0.5 * result;
}
int flatIndex(int x, int y, int z) {
    return (x - WorldOrigin.x) + WorldSize.x * (y - WorldOrigin.y) + WorldSize.x * WorldSize.y * (z - WorldOrigin.z);
} 
int flatIndex2D(int x, int z) {
    return (x - WorldOrigin.x) + WorldSize.x * (z * WorldOrigin.z);
}

const float4x4 gaussianMat =   {{ 0.00000067, 0.00002292, 0.00019117, 0.00038771},
                                { 0.00002292, 0.00078633, 0.00655965, 0.01330373},
                                { 0.00019117, 0.00655965, 0.05472157, 0.11098164},
                                { 0.00038771, 0.01330373, 0.11098164, 0.22508352}};
 
float getHeight(float3 p) {
    float big = noise(float3(p) + WorldOrigin, Seed + 1000, Scale * 0.2, Octaves, OctaveStrength * 0.8, OctaveScale);
    //h1 = pow(h1, 2);
    big = smoothstep(smoothstep(big));
    big *= 80;

    float mask_big = noise(p + float3(0,500,0) + WorldOrigin, Seed + 1000, Scale * .15, Octaves, 0.4* OctaveStrength, 1.2 * OctaveScale);
    mask_big = smoothstep(mask_big);
    big *= mask_big;

    float med = noise(float3(p) + WorldOrigin, Seed + 2000, Scale * .4, Octaves, 0.6 * OctaveStrength, OctaveScale);
    med *= 15;

    float small = noise(float3(p) + WorldOrigin, Seed + 100, Scale * 1, Octaves, OctaveStrength, OctaveScale);
    small *= 13;
    float mask_small = noise(float3(p) + WorldOrigin, Seed + 870, Scale * .7, Octaves, 0.8 * OctaveStrength, 0.8 * OctaveScale);
    mask_small = smoothstep(smoothstep(smoothstep(mask_small)));
    small *= mask_small;


    return 35 + 0.8 * (big + med + small);
}

uint3 GetStartP(uint3 id, uint3 threadSize) {
    return uint3(   id.x * ThreadSize.x,
                    id.y * ThreadSize.y,
                    id.z * ThreadSize.z) + uint3(WorldOrigin);
}
uint3 GetEndP(uint3 startP, uint3 threadSize) {
    return uint3(   startP.x + ThreadSize.x,
                    startP.y + ThreadSize.y,
                    startP.z + ThreadSize.z);
}
float GetSlope(uint x, uint z, int r) {
    // float h_o = NoiseBuffer[flatIndex(x, y, z)];
    // float h_nx = NoiseBuffer[flatIndex(clamp(x-r, 0, WorldSize.x), y, z)];
    // float h_px = NoiseBuffer[flatIndex(clamp(x+r, 0, WorldSize.x), y, z)];
    // float h_nz = NoiseBuffer[flatIndex(x, y, clamp(z-r, 0, WorldSize.z))];
    // float h_pz = NoiseBuffer[flatIndex(x, y, clamp(z+r, 0, WorldSize.z))];   

    float h_o = NoiseBuffer [flatIndex2D(x, z)];
    float h_nx = NoiseBuffer[flatIndex2D(clamp(x-r, 0, WorldSize.x), z)];
    float h_px = NoiseBuffer[flatIndex2D(clamp(x+r, 0, WorldSize.x), z)];
    float h_nz = NoiseBuffer[flatIndex2D(x, clamp(z-r, 0, WorldSize.z))];
    float h_pz = NoiseBuffer[flatIndex2D(x, clamp(z+r, 0, WorldSize.z))];   

    float dx = abs(h_o - h_nx) + abs(h_o - h_px);
    float dz = abs(h_o - h_nz) + abs(h_o - h_pz);
    return 1 * (dx + dz);
}
float GetBlurredH(uint x, uint z, int r) {

    float sum = NoiseBuffer[flatIndex2D(x, z)]; 
    
    int i0 = x - r;
    int i1 = x + r;
    int j0 = z - r;
    int j1 = z + r;

    int n=0;
    float w;
    for (int i=i0; i<i1; i++) { 
        for (int j=j0; j<j1; j++) {
            n++;
            float sample = NoiseBuffer[flatIndex2D(clamp(i,0,WorldSize.x),clamp(j,0,WorldSize.z))];
            float dist = distance(float2(x,z), float2(i,j));
            float weight = ((r-dist)/r);
            // sum = lerp(sum, sample, pow(clamp((r - dist)/r, 0, 1), 4));

            sum += sample * weight;
            w += weight;
            // float str = clamp(dot(float2(x,z), float2(i,j)),0,1);
            // sum = lerp(sum, sample, str);
            //sum = (sum + sample) / 2;
        }
    }
    return sum / w;

    // float h_o = NoiseBuffer [flatIndex2D(x, z)];
    // float h_nx = NoiseBuffer[flatIndex2D(clamp(x-r, 0, WorldSize.x), z)];
    // float h_px = NoiseBuffer[flatIndex2D(clamp(x+r, 0, WorldSize.x), z)];
    // float h_nz = NoiseBuffer[flatIndex2D(x, clamp(z-r, 0, WorldSize.z))];
    // float h_pz = NoiseBuffer[flatIndex2D(x, clamp(z+r, 0, WorldSize.z))];   

    // return (h_o + h_nx + h_px + h_nz + h_pz) / 5;
}



[numthreads(8,16,8)]
void InitialHeight (uint3 id : SV_DispatchThreadID)
{ 
    uint3 startP = GetStartP(id, ThreadSize);
    uint3 endP = GetEndP(startP, ThreadSize);

    for (uint x = startP.x; x < endP.x; x++) {
        for (uint z = startP.z; z < endP.z; z++) {
                            
            float3 p = float3(x,1.0,z);
            float h = getHeight(p);
            NoiseBuffer[flatIndex2D(x,z)] = h;
            // for (uint y = startY; y < startY + ThreadSize.y; y++) {
            //     NoiseBuffer[flatIndex(x, y, z)] = h;
            // }

        }
    }
     
    //Result[id.xy] = float4(id.x & id.y, (id.x & 15)/15.0, (id.y & 15)/15.0, 0.0);
}



[numthreads(8,16,8)]
void PostProcess(uint3 id : SV_DispatchThreadID)
{ 
    
    uint3 startP = GetStartP(id, ThreadSize);
    uint3 endP = GetEndP(startP, ThreadSize);
    
    for (uint x = startP.x; x < endP.x; x++) {
        for (uint z = startP.z; z < endP.z; z++) {    
                            
            float layerNoise = 2 * noise(float3(x,1,z) + WorldOrigin, Seed + 35, Scale * 1 * float3(1,.7,1), 5, 0.7 * OctaveStrength, 1.2 * OctaveScale);
  
            for (uint y = startP.y; z < endP.y; y++) {
                
                int index = flatIndex(x,y,z);

                float3 p = float3(x,y,z);
                
                float h = NoiseBuffer[flatIndex(x, y, z)];

                // slope
                float steep = GetSlope(x,z,1);//length(slope);
                
                //h = GenerateErosion(x,y,z, h);
                float depth = h - y;

                float surface = y/h;

                // h += (50 * layerNoise); 
                // surface += (1 * layerNoise);

                float soil = 0.01 + 0.08 * noise(p + WorldOrigin, Seed + 17, Scale * 0.003 * float3(1,0.1,1), Octaves, 0.5 * OctaveStrength, 1 * OctaveScale);
                soil *= (lerp(0, (6-steep), pow(surface, 5)));

                float coalOre = noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed +5943, Scale * 1.3 * float3(1,4,1), Octaves, 0.8 * OctaveStrength, OctaveScale);
                coalOre = clamp((coalOre - 0.0) * clamp(1-0.3*surface, 0.5, 1), 0, 1);

                if (surface < 1) {
                    float sand = (1.3 - surface) *  noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed + 5, Scale * .7 * float3(1,4,1), Octaves, OctaveStrength, OctaveScale);
                    float silt = 1.0 *              noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed + 6, Scale * .7 * float3(1,4,1), Octaves, OctaveStrength, OctaveScale);
                    float clay = 1.0 *              noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed + 7, Scale * .7 * float3(1,4,1), Octaves, OctaveStrength, OctaveScale);
                    
                    SoilBuffer[index] = float3(sand, silt, clay);
                    
                    if (surface > 1-soil) {
                        
                        if (silt > sand && silt > clay) {
                            VoxelBufferW[index] = 1;      
                        }
                        else if (sand > silt && sand > clay) {
                            VoxelBufferW[index] = 2;      
                        }
                        else if (clay > silt && clay > sand ) {
                            VoxelBufferW[index] = 3;      
                        }
                        else {
                            VoxelBufferW[index] = 4;      
                        }
                    }
                    else {
                    //else if (surface > 0.3 + 0.5 * layerNoise) {
                        if (y > 10 * layerNoise  + 0.5* h - 20) {
                            if (silt > sand && silt > clay) {
                                    VoxelBufferW[index] = 6;      
                                }
                                else if (sand > silt && sand > clay) {
                                    VoxelBufferW[index] = 7;      
                                }
                                else {
                                    VoxelBufferW[index] = 8;      
                                }

                        }   
                        else  {
                                if (silt > sand && silt > clay) {
                                    VoxelBufferW[index] = 9;      
                                }
                                else if (sand > silt && sand > clay) {
                                    VoxelBufferW[index] = 10;      
                                }
                                else {
                                    VoxelBufferW[index] = 11;      
                                }
                        }
                        if (coalOre > 0.75) {
                            VoxelBufferW[index] = 14;      
                        }
                    }
          

                }
                else {
                    VoxelBufferW[index] = 0;      
                }

            }
        }
    }
    
}

[numthreads(8,16,8)]
void SetStone(uint3 id : SV_DispatchThreadID)
{ 
    
    uint3 startP = GetStartP(id, ThreadSize);
    uint3 endP = GetEndP(startP, ThreadSize);
    
    for (uint x = startP.x; x < endP.x; x++) {
        for (uint z = startP.z; z < endP.z; z++) {         
                            
            float layerNoise = 2 * noise(float3(x,1,z) + WorldOrigin, Seed + 35, Scale * .1 * float3(1,.6,1), 5, 0.7 * OctaveStrength, 1.2 * OctaveScale);
            float h = NoiseBuffer[flatIndex2D(x, z)];
            
            for (uint y = startP.y; y < endP.y; y++) {
                
                int index = flatIndex(x,y,z);

                float3 p = float3(x,y,z);
                


                // slope
                float steep = GetSlope(x,z,1);//length(slope);
                
                //h = GenerateErosion(x,y,z, h);
                float depth = h - y;

                float surface = y/h;

                // h += (50 * layerNoise); 
                // surface += (1 * layerNoise);

                if (surface < 1) {
                    float sand = (1.3-surface)*0 +  noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed + 5, Scale * .1 * float3(1,22,1), Octaves, OctaveStrength, OctaveScale);
                    float silt = 1.0 *              noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed + 6, Scale * .1 * float3(1,22,1), Octaves, OctaveStrength, OctaveScale);
                    float clay = 1.0 *              noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed + 7, Scale * .1 * float3(1,22,1), Octaves, OctaveStrength, OctaveScale);
                    
                    SoilBuffer[index] = float3(sand, silt, clay);
                    
                    
                    if (y > 10 * layerNoise  + 0.5* h - 20) {
                        if (silt > sand && silt > clay) {
                            VoxelBufferW[index] = 6;      
                        }
                        else if (sand > silt && sand > clay) {
                            VoxelBufferW[index] = 7;      
                        }
                        else {
                            VoxelBufferW[index] = 8;      
                        }

                    }   
                    else  {
                            if (silt > sand && silt > clay) {
                                VoxelBufferW[index] = 9;      
                            }
                            else if (sand > silt && sand > clay) {
                                VoxelBufferW[index] = 10;      
                            }
                            else {
                                VoxelBufferW[index] = 11;      
                            }
                    }
                }
                else {
                    VoxelBufferW[index] = 0;      
                }
            }
        }
    }
}

[numthreads(8,16,8)]
void ErodeSurface(uint3 id : SV_DispatchThreadID)
{ 
    uint3 startP = GetStartP(id, ThreadSize);
    uint3 endP = GetEndP(startP, ThreadSize);
    
    for (uint x = startP.x; x < endP.x; x++) {
        for (uint z = startP.z; z < endP.z; z++) {     

            float erodeH = noise(float3(x,1,z) + WorldOrigin, Seed + 6393, Scale * .2 * float3(1,.7,1), 5, 0.5 * OctaveStrength, 1.2 * OctaveScale);     
            erodeH = clamp(erodeH, 0, 1);
            erodeH = smoothstep(smoothstep(erodeH));
            erodeH *= 1; //0.8;
            erodeH -= 1.15;
            
            float h = NoiseBuffer[flatIndex2D(x,z)];
            float newH = clamp(h  - erodeH, 0, h);

            for (uint y = startP.y; y < endP.y; y++) { 

                int index = flatIndex(x,y,z);
                
                if (VoxelBufferR[index] > 0) {
                    
  
                    float surface = y/h;

                    if (surface >= h/WorldSize.y -  erodeH) {
                        NoiseBuffer[flatIndex2D(x,z)] = y-1;
                        VoxelBufferW[index] = 0;
                       //VoxelBufferW[flatIndex(x,y-1,z)] = 1;
                    }
                    //else if (abs(y - (WorldSize.y - erodeH)) < 1) {
                    else if (abs(surface - (h/WorldSize.y -  erodeH)) > .02 && VoxelBufferR[flatIndex(x, y+1, z)] == 0) {
                        //VoxelBufferW[index] = 1;
                    }
                }
            }
        }
    }
}

[numthreads(8,16,8)]
void AddSoilLayer(uint3 id : SV_DispatchThreadID)
{ 
    uint3 startP = GetStartP(id, ThreadSize);
    uint3 endP = GetEndP(startP, ThreadSize);
    
    for (uint x = startP.x; x < endP.x; x++) {
        for (uint z = startP.z; z < endP.z; z++) { 

            float blurNoise = noise(float3(x,1,z) + WorldOrigin, Seed + 25633, Scale * .3* float3(1,.7,1), 5, 0.6 * OctaveStrength, 1 * OctaveScale);

            float blurredH = 1 * GetBlurredH(x, z, 10) - 3 + 2*clamp(blurNoise, 0, 1);
            float blurredH2= 0.97 * GetBlurredH(x, z,28) + 2;// - 0*clamp(blurNoise, 0, 1);
            blurredH = max(blurredH, blurredH2);

            //float currentH = NoiseBuffer[flatIndex2D(x,z)];
            for (uint y = startP.y; y < endP.y; y++) { 

                int index = flatIndex(x,y,z);
                float soilNoise = noise(float3(x,y,z) + WorldOrigin, Seed + 763126, Scale * .25 * float3(1,14,1), Octaves, OctaveStrength, OctaveScale);
                 
                if (VoxelBufferR[index] == 0 && y < blurredH) {
                    
                    if (soilNoise > 0.5) {
                        VoxelBufferW[index] = 1;      
                    }
                    else {
                        VoxelBufferW[index] = 3;      
                    }
                    //VoxelBufferW[index] = 1;
                }
            }
        }
    }   
}

[numthreads(8,16,8)]
void AddWater(uint3 id : SV_DispatchThreadID)
{ 
    const int WATER_ID = 15;
    uint3 startP = GetStartP(id, ThreadSize);
    uint3 endP = GetEndP(startP, ThreadSize);
    
    for (uint x = startP.x; x < endP.x; x++) {
        for (uint z = startP.z; z < endP.z; z++) { 
            for (uint y = startP.y; y < endP.y; y++) { 
                int index = flatIndex(x,y,z);
                if (VoxelBufferR[index] == 0 && y < 35) {
                    VoxelBufferW[index] = WATER_ID;
                }
            }
        }
    }
}

[numthreads(8,16,8)]
void RandomInt(uint3 id : SV_DispatchThreadID)
{ 
    uint3 startP = GetStartP(id, ThreadSize);
    uint3 endP = GetEndP(startP, ThreadSize);
    
    for (uint x = startP.x; x < endP.x; x++) {
        for (uint z = startP.z; z < endP.z; z++) { 
            for (uint y = startP.y; y < endP.y; y++) { 
                float n = frac(50 * noise(float3(x,y,z) + WorldOrigin, Seed + 802123, 50000 * float3(1,1,1), 1, 1, 1));
                RandomBuffer[flatIndex(x,y,z)] = floor(n * 1000);
            }
        }
    }
}

[numthreads(8,16,8)]
void AddTrees(uint3 id : SV_DispatchThreadID)
{ 
    
    uint3 startP = GetStartP(id, ThreadSize);
    uint3 endP = GetEndP(startP, ThreadSize);
    
    for (uint x = startP.x; x < endP.x; x++) {
        for (uint z = startP.z; z < endP.z; z++) { 
            for (uint y = startP.y; y < endP.y; y++) { 
                
                int index = flatIndex(x,y,z);

                int vox = VoxelBufferR[index];
                if (vox == 1 || vox == 2 || vox == 3 || vox == 4) {

                    int vox_above = VoxelBufferR[flatIndex(x, y+1, z)];
                    float n = noise(float3(x,y,z),  Seed, 30 * float3(1,1,1), 3, 1, 6);
                    float mask = noise(float3(x,y,z) + WorldOrigin, Seed + 870, Scale * .7, Octaves, 0.8 * OctaveStrength, 0.8 * OctaveScale);
                    mask = 1.2 * smoothstep(mask);
                    n *= mask;

                    n = (x%2 == z%2) ? 0 : n;
                    if (vox_above == 0 && n > 0.9) {
                        VoxelBufferW[flatIndex(x, y+1, z)] = 12;
                        VoxelBufferW[flatIndex(x, y+2, z)] = 12;
                        VoxelBufferW[flatIndex(x,    y+3, z)] = 13;
                        VoxelBufferW[flatIndex(x-1,  y+3, z)] = 13;
                        VoxelBufferW[flatIndex(x+1,  y+3, z)] = 13;
                        VoxelBufferW[flatIndex(x,    y+3, z-1)] = 13;
                        VoxelBufferW[flatIndex(x,    y+3, z+1)] = 13;
                        VoxelBufferW[flatIndex(x, y+4, z)] = 13;
                        VoxelBufferW[flatIndex(x, y+5, z)] = 13;
                    }
                }
            }
        }
    }
}


[numthreads(8,16,8)]
void GenerateNoiseCaves(uint3 id : SV_DispatchThreadID)
{
    uint startX = id.x * ThreadSize.x;
    uint startY = id.y * ThreadSize.y;
    uint startZ = id.z * ThreadSize.z;

    for (uint x = startX; x < startX + ThreadSize.x; x++) {
        for (uint y = startY; y < startY + ThreadSize.y; y++) {
            for (uint z = startZ; z < startZ + ThreadSize.z; z++) {
                
                float n = noise(float3(x,y,z), Seed, Scale, Octaves, OctaveStrength, OctaveScale);

                float edge1 = clamp(remap(n, 0.5 - CaveWidth * 2, 0.5 - CaveWidth, 0, 1), 0, 1);
                float edge2 = clamp(remap(n, 0.5 + CaveWidth, 0.5 + CaveWidth * 2, 1, 0), 0, 1);
                float cave = edge1 * edge2;
                
                float h = float(y) / float(WorldSize.y);
                cave *= 0.7;

                NoiseBuffer[x + WorldSize.x * y + WorldSize.x * WorldSize.y * z] = cave;
                
            }
        }
    }
     
    //Result[id.xy] = float4(id.x & id.y, (id.x & 15)/15.0, (id.y & 15)/15.0, 0.0);
}





