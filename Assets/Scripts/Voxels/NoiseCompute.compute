#pragma kernel InitialHeight
#pragma kernel PostProcess
#pragma kernel AddTrees
#pragma kernel GenerateNoiseCaves
//#pragma kernel GenerateErosion

#include "Packages/jp.keijiro.noiseshader/Shader/SimplexNoise3D.hlsl"
#include "Packages/jp.keijiro.noiseshader/Shader/ClassicNoise3D.hlsl"
#include "Assets/Art/Shaders/Hash.hlsl"
#include "Assets/Art/Shaders/ErosionTerrain.hlsl"


//RWTexture2DArray<float> Result;
RWStructuredBuffer<float> NoiseBuffer;
RWStructuredBuffer<int> VoxelBuffer;
uint3 WorldSize;
uint3 WorldOrigin;

uint3 ThreadCount;
uint3 ThreadSize;
int Seed;

float3 Scale;
float3 Offset;
int Octaves; 
float OctaveStrength;
float OctaveScale;

float CaveWidth;

float remap(float value, float originMin, float originMax, float destinationMin, float destinationMax) {
    return destinationMin + (value - originMin) * (destinationMax - destinationMin) / (originMax - originMin);
}
float smoothstep(float x) {
    float t = clamp(x / 1, 0, 1);
    return t * t * (3-2*t);
}

float noise(float3 p, int seed, float3 scale, int octaves, float octaveStrength, float octaveScale) {
    float result = 0;
    float str = 1;
    float3 scaleO = scale;

    float3 seedP = hash31(seed+1); 

    for (int o = 0; o < octaves; o++)
    {    
        result += str * SimplexNoise(p * scaleO + seedP);
        str *= octaveStrength;
        scaleO *= octaveScale;
    }
    return 0.5 + 0.5 * result;
}

int flatIndex(int x, int y, int z) {
    return x + WorldSize.x * y + WorldSize.x * WorldSize.y * z;
} 
 
float getHeight(float3 p) {
    float big = noise(float3(p) + WorldOrigin, Seed + 1000, Scale * 0.3, Octaves, OctaveStrength * 0.8, OctaveScale);
    //h1 = pow(h1, 2);
    big = smoothstep(smoothstep(big));
    big *= 80;

    float mask_big = noise(p + float3(0,500,0) + WorldOrigin, Seed + 1000, Scale * .15, Octaves, 0.4* OctaveStrength, 1.2 * OctaveScale);
    mask_big = smoothstep(mask_big);
    big *= mask_big;

    float med = noise(float3(p) + WorldOrigin, Seed + 2000, Scale * .5, Octaves, 0.6 * OctaveStrength, OctaveScale);
    med *= 15;

    float small = noise(float3(p) + WorldOrigin, Seed + 100, Scale * 1, Octaves, OctaveStrength, OctaveScale);
    small *= 13;
    float mask_small = noise(float3(p) + WorldOrigin, Seed + 870, Scale * .7, Octaves, 0.8 * OctaveStrength, 0.8 * OctaveScale);
    mask_small = smoothstep(smoothstep(smoothstep(mask_small)));
    small *= mask_small;


    return 65 + 0.7 * (big + med + small);
}



[numthreads(8,8,8)]
void InitialHeight (uint3 id : SV_DispatchThreadID)
{ 
    
    uint startX = id.x * ThreadSize.x;
    uint startY = id.y * ThreadSize.y; 
    uint startZ = id.z * ThreadSize.z;

    for (uint x = startX; x < startX + ThreadSize.x; x++) {
        for (uint z = startZ; z < startZ + ThreadSize.z; z++) {
                            
            float3 p = float3(x,1.0,z);
            float h = getHeight(p);
            for (uint y = startY; y < startY + ThreadSize.y; y++) {
                NoiseBuffer[flatIndex(x, y, z)] = h;
            }

        }
    }
     
    //Result[id.xy] = float4(id.x & id.y, (id.x & 15)/15.0, (id.y & 15)/15.0, 0.0);
}

float GetSlope(uint x, uint y, uint z, int r) {
    float h_o = NoiseBuffer[flatIndex(x, y, z)];
    float h_nx = NoiseBuffer[flatIndex(clamp(x-r, 0, WorldSize.x), y, z)];
    float h_px = NoiseBuffer[flatIndex(clamp(x+r, 0, WorldSize.x), y, z)];
    float h_nz = NoiseBuffer[flatIndex(x, y, clamp(z-r, 0, WorldSize.z))];
    float h_pz = NoiseBuffer[flatIndex(x, y, clamp(z+r, 0, WorldSize.z))];   

    float dx = abs(h_o - h_nx) + abs(h_o - h_px);
    float dz = abs(h_o - h_nz) + abs(h_o - h_pz);
    return 1 * (dx + dz);
}


[numthreads(8,8,8)]
void PostProcess(uint3 id : SV_DispatchThreadID)
{ 
    
    uint startX = id.x * ThreadSize.x;
    uint startY = id.y * ThreadSize.y; 
    uint startZ = id.z * ThreadSize.z;

    for (uint x = startX; x < startX + ThreadSize.x; x++) {
        for (uint z = startZ; z < startZ + ThreadSize.z; z++) {        
                            
            float layerNoise = 2 * noise(float3(x,1,z) + WorldOrigin, Seed + 35, Scale * 1 * float3(1,.7,1), 5, 0.7 * OctaveStrength, 1.2 * OctaveScale);
  
            for (uint y = startY; y < startY + ThreadSize.y; y++) {
                
                float3 p = float3(x,y,z);
                
                float h = NoiseBuffer[flatIndex(x, y, z)];

                // slope
                float steep = GetSlope(x,y,z,1);//length(slope);
                
                //h = GenerateErosion(x,y,z, h);
                float depth = h - y;

                float surface = y/h;

                // h += (50 * layerNoise); 
                // surface += (1 * layerNoise);

                float soil = 0.01 + 0.08 * noise(p + WorldOrigin, Seed + 17, Scale * 0.003 * float3(1,0.1,1), Octaves, 0.5 * OctaveStrength, 1 * OctaveScale);
                soil *= (lerp(0, (6-steep), pow(surface, 5)));

                float coalOre = noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed +5943, Scale * 1.3 * float3(1,4,1), Octaves, 0.8 * OctaveStrength, OctaveScale);
                coalOre = clamp((coalOre - 0.0) * clamp(1-0.3*surface, 0.5, 1), 0, 1);

                if (surface < 1) {
                    float sand = (1.3 - surface) *  noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed + 5, Scale * .7 * float3(1,4,1), Octaves, OctaveStrength, OctaveScale);
                    float silt = 1.0 *              noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed + 6, Scale * .7 * float3(1,4,1), Octaves, OctaveStrength, OctaveScale);
                    float clay = 1.0 *              noise(p + WorldOrigin - 0.4 * float3(0,h + 20 * layerNoise * clamp(1-surface,0,1),0), Seed + 7, Scale * .7 * float3(1,4,1), Octaves, OctaveStrength, OctaveScale);

                    
                    if (surface > 1-soil) {
                        
                        if (silt > sand && silt > clay) {
                            VoxelBuffer[flatIndex(x, y, z)] = 1;      
                        }
                        else if (sand > silt && sand > clay) {
                            VoxelBuffer[flatIndex(x, y, z)] = 2;      
                        }
                        else if (clay > silt && clay > sand ) {
                            VoxelBuffer[flatIndex(x, y, z)] = 3;      
                        }
                        else {
                            VoxelBuffer[flatIndex(x, y, z)] = 4;      
                        }
                    }
                    else {
                    //else if (surface > 0.3 + 0.5 * layerNoise) {
                        if (y > 10 * layerNoise  + 0.5* h - 20) {
                            if (silt > sand && silt > clay) {
                                    VoxelBuffer[flatIndex(x, y, z)] = 6;      
                                }
                                else if (sand > silt && sand > clay) {
                                    VoxelBuffer[flatIndex(x, y, z)] = 7;      
                                }
                                else {
                                    VoxelBuffer[flatIndex(x, y, z)] = 8;      
                                }

                        }   
                        else  {
                                if (silt > sand && silt > clay) {
                                    VoxelBuffer[flatIndex(x, y, z)] = 9;      
                                }
                                else if (sand > silt && sand > clay) {
                                    VoxelBuffer[flatIndex(x, y, z)] = 10;      
                                }
                                else {
                                    VoxelBuffer[flatIndex(x, y, z)] = 11;      
                                }
                        }
                        if (coalOre > 0.75) {
                            VoxelBuffer[flatIndex(x, y, z)] = 14;      
                        }
                    }
          

                }
                else {
                    VoxelBuffer[flatIndex(x, y, z)] = 0;      
                }

            }
        }
    }
    
}

[numthreads(8,8,8)]
void AddTrees(uint3 id : SV_DispatchThreadID)
{ 
    
    uint startX = id.x * ThreadSize.x;
    uint startY = id.y * ThreadSize.y; 
    uint startZ = id.z * ThreadSize.z;

    for (uint x = startX; x < startX + ThreadSize.x; x++) {
        for (uint z = startZ; z < startZ + ThreadSize.z; z++) {          
            for (uint y = startY; y < startY + ThreadSize.y; y++) {
                int vox = VoxelBuffer[flatIndex(x, y, z)];
                if (vox == 1 || vox == 2 || vox == 3 || vox == 4) {
                    int vox_above = VoxelBuffer[flatIndex(x, y+1, z)];
                    float n = noise(float3(x,y,z),  Seed, 30 * float3(1,1,1), 3, 1, 6);
                    float mask = noise(float3(x,y,z) + WorldOrigin, Seed + 870, Scale * .7, Octaves, 0.8 * OctaveStrength, 0.8 * OctaveScale);
                    mask = 1.2 * smoothstep(mask);
                    n *= mask;

                    n = (x%2 == z%2) ? 0 : n;
                    if (vox_above == 0 && n > 0.9) {
                        VoxelBuffer[flatIndex(x, y+1, z)] = 12;
                        VoxelBuffer[flatIndex(x, y+2, z)] = 12;

                        VoxelBuffer[flatIndex(x,    y+3, z)] = 13;
                        VoxelBuffer[flatIndex(x-1,  y+3, z)] = 13;
                        VoxelBuffer[flatIndex(x+1,  y+3, z)] = 13;
                        VoxelBuffer[flatIndex(x,    y+3, z-1)] = 13;
                        VoxelBuffer[flatIndex(x,    y+3, z+1)] = 13;

                        VoxelBuffer[flatIndex(x, y+4, z)] = 13;
                        VoxelBuffer[flatIndex(x, y+5, z)] = 13;
                    }
                }
            }
        }
    }
}


[numthreads(8, 8, 8)]
void GenerateNoiseCaves(uint3 id : SV_DispatchThreadID)
{
    uint startX = id.x * ThreadSize.x;
    uint startY = id.y * ThreadSize.y;
    uint startZ = id.z * ThreadSize.z;

    for (uint x = startX; x < startX + ThreadSize.x; x++) {
        for (uint y = startY; y < startY + ThreadSize.y; y++) {
            for (uint z = startZ; z < startZ + ThreadSize.z; z++) {
                
                float n = noise(float3(x,y,z), Seed, Scale, Octaves, OctaveStrength, OctaveScale);

                float edge1 = clamp(remap(n, 0.5 - CaveWidth * 2, 0.5 - CaveWidth, 0, 1), 0, 1);
                float edge2 = clamp(remap(n, 0.5 + CaveWidth, 0.5 + CaveWidth * 2, 1, 0), 0, 1);
                float cave = edge1 * edge2;
                
                float h = float(y) / float(WorldSize.y);
                cave *= 0.7;

                NoiseBuffer[x + WorldSize.x * y + WorldSize.x * WorldSize.y * z] = cave;
                
            }
        }
    }
     
    //Result[id.xy] = float4(id.x & id.y, (id.x & 15)/15.0, (id.y & 15)/15.0, 0.0);
}





